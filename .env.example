# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://example.com"

# ROTACLUB_JWT_SECRET: 64+ character cryptographic HMAC-SHA256 secret for signing session tokens (#22)
ROTACLUB_JWT_SECRET=""

# Optional initial bootstrap credentials for club accounts (#22, #70)
# If omitted, CSPRNG strong credentials are generated on first boot into .aistudio/.bootstrap_credentials.json (0600)
ROTACLUB_PIN_UYE=""
ROTACLUB_PIN_SEKRETER=""
ROTACLUB_PIN_SAYMAN=""
ROTACLUB_PIN_BASKAN=""
ROTACLUB_PIN_KARAKOY_BASKAN=""
ROTACLUB_PIN_MACKA_BASKAN=""
ROTACLUB_PIN_DISTRICT_GOV=""
